# ============================================================
#  Omgevingsvariabelen - Marketing dashboard
#  Kopieer dit bestand naar .env.local (lokaal) en zet dezelfde
#  waarden in Vercel > Project > Settings > Environment Variables.
#  Commit NOOIT je echte .env / .env.local naar GitHub.
# ============================================================

# --- Publiek (mag in de frontend) ---------------------------
# Deze twee worden door de build-stap in js/env.js gezet en zijn
# zichtbaar in de browser. Dat is veilig: de beveiliging komt van RLS.
SUPABASE_URL=https://JOUW-PROJECT.supabase.co
SUPABASE_ANON_KEY=jouw_supabase_anon_of_publishable_key

# --- Geheim (ALLEEN server-side, nooit in de frontend) ------
# Wordt uitsluitend gebruikt door de serverless functie /api/users.
# Zet deze in Vercel als "Encrypted" / server-only. Deze waarde mag
# NOOIT in js/config.js, js/env.js of enige clientcode terechtkomen.
SUPABASE_SERVICE_ROLE_KEY=jouw_supabase_service_role_key
